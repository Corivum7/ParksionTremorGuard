# TremorGuard 前端服务（admin-console：Vite 构建 + nginx 托管）
# 构建上下文：仓库根目录

# ---- 阶段1：构建静态产物 ----
FROM node:18-alpine AS builder

WORKDIR /app

# 激活 pnpm 8（与 packageManager 字段一致）
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

# 先复制 workspace 配置与各包 package.json，利用 Docker 层缓存
COPY tremorguard-frontend/package.json \
     tremorguard-frontend/pnpm-lock.yaml \
     tremorguard-frontend/pnpm-workspace.yaml \
     tremorguard-frontend/turbo.json \
     tremorguard-frontend/tsconfig.base.json \
     ./

COPY tremorguard-frontend/apps/admin-console/package.json ./apps/admin-console/
COPY tremorguard-frontend/apps/doctor-dashboard/package.json ./apps/doctor-dashboard/
COPY tremorguard-frontend/packages/shared-types/package.json ./packages/shared-types/
COPY tremorguard-frontend/packages/utils/package.json ./packages/utils/
COPY tremorguard-frontend/packages/ble-service/package.json ./packages/ble-service/
COPY tremorguard-frontend/packages/local-db/package.json ./packages/local-db/
COPY tremorguard-frontend/packages/sync-engine/package.json ./packages/sync-engine/

# 安装依赖（frozen-lockfile 保证可重现构建）
RUN pnpm install --frozen-lockfile

# 复制源码
COPY tremorguard-frontend/ ./

# 仅构建 admin-console（Web 控制台）
RUN pnpm --filter @tremorguard/admin-console build

# ---- 阶段2：nginx 托管静态文件 ----
FROM nginx:alpine

# 移除默认配置，使用自定义模板
RUN rm /etc/nginx/conf.d/default.conf

COPY nginx.conf.template /etc/nginx/conf.d/configfile.template
COPY --from=builder /app/apps/admin-console/dist /usr/share/nginx/html

ENV PORT=80
ENV BACKEND_HOST=backend.zeabur.internal
ENV BACKEND_PORT=8000

EXPOSE 80

# 启动时用 envsubst 注入端口与后端地址，再启动 nginx
CMD sh -c "envsubst '\$PORT \$BACKEND_HOST \$BACKEND_PORT' < /etc/nginx/conf.d/configfile.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"
