# TremorGuard 后端服务（FastAPI + uvicorn）
# 构建上下文：仓库根目录

FROM python:3.12-slim

WORKDIR /app

# 系统依赖：asyncpg 编译需要 build-essential，运行需要 libpq
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv（Astral 官方镜像二进制）
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# 先复制依赖清单以利用 Docker 层缓存
COPY tremorguard-backend/pyproject.toml tremorguard-backend/uv.lock ./

# 安装生产依赖（frozen 保证与 lockfile 一致，no-dev 跳过开发依赖）
RUN uv sync --frozen --no-dev

# 复制源码
COPY tremorguard-backend/ ./

ENV PYTHONUNBUFFERED=1
ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

# 启动：执行数据库迁移后启动 ASGI 服务
CMD ["sh", "-c", "alembic upgrade head && uvicorn tremorguard_backend.main:app --host 0.0.0.0 --port ${APP_PORT:-8000}"]
